{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentree",
  "version": "0.3.3",
  "identifier": "com.agentree.agentree",
  "build": {
    "beforeDevCommand": "pnpm run dev:raw",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentree",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/artifacts/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "scripts/ai-label-prompt.txt",
      "scripts/bash-adapter.cjs",
      "scripts/claude-agent-sdk-adapter.mjs",
      "scripts/merge-review-runner.cjs",
      "scripts/opencode-agent-sdk-adapter.mjs",
      "scripts/package-manager-guard.sh"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentree"
        ]
      }
    },
    "updater": {
      "pubkey": ""
    }
  }
}
