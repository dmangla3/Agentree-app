{
  "name": "tauri-app",
  "private": true,
  "version": "0.3.4",
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm run dev:tauri",
    "dev:tauri": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:tauri:raw": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "pnpm run dev:raw",
    "dev:raw": "vite",
    "build": "pnpm run build:raw",
    "build:raw": "tsc && vite build",
    "preview": "vite preview",
    "perf:send-flow:tauri": "node ./tests/perf/tauri-pilot-send-flow-autonomous.mjs",
    "perf:send-click-feedback:tauri": "node ./tests/perf/tauri-pilot-click-feedback-flow.mjs",
    "perf:one-running-retarget:tauri": "node ./tests/perf/tauri-pilot-one-running-retarget-flow.mjs",
    "perf:send-flow:tauri:polling": "node ./tests/perf/tauri-pilot-send-flow-repro.mjs",
    "perf:composer-typing:tauri": "node ./tests/perf/tauri-pilot-composer-typing-latency.mjs",
    "perf:scroll-behavior:tauri": "node ./tests/perf/tauri-pilot-scroll-behavior-flow.mjs",
    "perf:latest-summary": "node ./scripts/perf-latest-summary.mjs",
    "perf:trace": "node ./scripts/perf-trace.mjs",
    "smoke:send-flow:tauri": "node ./tests/perf/tauri-pilot-send-stream-status-smoke.mjs",
    "pilot:install": "cargo install tauri-pilot-cli --locked",
    "pilot:dev": "pnpm run dev",
    "pilot:graph-node-hover": "node ./tests/pilot/graph-node-hover-probe.mjs",
    "pilot:smoke": "node ./tests/pilot/smoke-ui.mjs",
    "pilot:test-ui": "node ./tests/pilot/run-dev-and-smoke.mjs",
    "audit:agent-runs": "node ./scripts/audit-agent-run-lifecycle.mjs",
    "audit:context-routing": "node ./scripts/audit-agent-context-routing.cjs",
    "tauri": "node ./scripts/tauri-cli.mjs",
    "tauri:dev": "pnpm run dev",
    "version:sync": "node ./scripts/sync-version.mjs",
    "appimage:repair-icon": "node ./scripts/repair-linux-appimage-icon.mjs",
    "tauri:build:prod": "pnpm run tauri:build:prod:raw",
    "tauri:build:prod:raw": "tauri build && pnpm run appimage:repair-icon",
    "test": "pnpm run test:ci",
    "test:ci": "pnpm run test:unit && pnpm run test:runtime-archives && pnpm run test:contracts && pnpm run test:perf:deterministic",
    "test:unit": "node ./scripts/run-unit-tests.mjs",
    "test:runtime-archives": "node --test scripts/runtime-archive-cache.test.mjs scripts/runtime-archive-layout.test.mjs scripts/runtime-manifest-artifacts.test.mjs scripts/vite-cache-dir.test.mjs src-tauri/scripts/claude-agent-sdk-adapter.test.mjs src-tauri/scripts/opencode-agent-sdk-adapter.test.mjs",
    "test:contracts": "vitest run src/mocks",
    "test:graph": "vitest run src/lib/graphLayoutGeometry.test.ts src/lib/graphThreadRoots.test.ts src/lib/graphSubgraphFilter.test.ts src/hooks/graph src/components/GraphView.focusMove.test.ts src/components/graph src/components/nodes/graph src/mocks/frontendProjection.msw.test.ts",
    "test:send": "vitest run src/agent-runs src/lib/composerSendParent.test.ts src/lib/composerAgentRuns.test.ts src/perf/sendFlow.test.ts",
    "test:rust": "cd src-tauri && cargo test",
    "test:perf:deterministic": "vitest run src/perf scripts/perf-latest-summary.test.mjs scripts/perf-trace.test.mjs tests/perf/tauri-pilot-chat-hot-path-lib.test.mjs tests/perf/tauri-pilot-click-feedback-lib.test.mjs tests/perf/tauri-pilot-desktop-preflight-lib.test.mjs tests/perf/tauri-pilot-report-lib.test.mjs src/mocks/frontendProjection.msw.test.ts src/hooks/graph/useGraphLayout.visualReuse.test.tsx src/lib/graphLayoutGeometry.test.ts",
    "test:perf:pilot": "pnpm run smoke:send-flow:tauri && pnpm run perf:send-flow:tauri && pnpm run perf:cancel:tauri && pnpm run perf:composer-typing:tauri && pnpm run perf:scroll-behavior:tauri && pnpm run perf:graph-100:tauri && pnpm run perf:parallel:tauri",
    "test:agent-runs": "vitest run src/agent-runs/*.test.ts",
    "perf:cancel:tauri": "node ./tests/perf/tauri-pilot-cancel-flow.mjs",
    "perf:graph-interaction:tauri": "node ./tests/perf/tauri-pilot-graph-interaction-flow.mjs",
    "perf:graph-100:tauri": "AGENTREE_TAURI_PILOT_MIN_GRAPH_NODES=100 node ./tests/perf/tauri-pilot-graph-interaction-flow.mjs",
    "perf:native-lifecycle-idle:tauri": "node ./tests/perf/tauri-pilot-native-lifecycle-idle-flow.mjs",
    "perf:parallel:tauri": "node ./tests/perf/tauri-pilot-staggered-parent-parallel-flow.mjs",
    "perf:parallel:tauri:basic": "node ./tests/perf/tauri-pilot-parallel-agent-flow.mjs",
    "bindings:tauri": "cd src-tauri && cargo test export_tauri_specta_bindings -- --ignored --nocapture",
    "bindings:tauri:check": "pnpm run bindings:tauri && git diff --exit-code -- src/generated/tauri-bindings.ts",
    "perf:graph-composer-open:tauri": "node ./tests/perf/tauri-pilot-graph-composer-open-flow.mjs",
    "smoke:graph-composer-send:tauri": "node ./tests/perf/tauri-pilot-graph-composer-send-flow.mjs",
    "smoke:steering-surfaces:tauri": "node ./tests/perf/tauri-pilot-steering-surfaces-smoke.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.39.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@kinde-oss/kinde-auth-react": "^5.10.1",
    "@kinde/js-utils": "0.29.0",
    "@opencode-ai/sdk": "1.18.3",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "1.2.12",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "agentation": "^1.3.0",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.26.2",
    "geist": "^1.7.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.15.0",
    "nf-droid-sans-mono": "2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.31.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "picomatch": "^4.0.4",
    "rollup": "^4.60.3"
  }
}
